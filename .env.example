# Public URL used for canonical links, cookies, and trusted-origin checks.
# 生产环境可在后台 /admin/settings 修改，保存后立即生效。
APP_URL=http://localhost:3000

# Runtime data paths. Production Compose mounts /app/data as a persistent volume.
DATABASE_PATH=./data/blog.db
UPLOAD_DIR=./data/uploads

# 本地开发默认值。生产环境可不设置：首次启动自动生成并持久化到 data/secrets/。
AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
VISITOR_HASH_SECRET=replace-with-another-random-secret-at-least-32-characters

# Comma-separated origins allowed to submit authenticated or public write requests.
# 生产环境可在后台 /admin/settings 修改，保存后立即生效。
TRUSTED_ORIGINS=http://localhost:3000

LOG_LEVEL=info

# Data-package and full-backup ZIP safety limits.
DATA_ARCHIVE_MAX_BYTES=1073741824
DATA_ARCHIVE_MAX_ENTRIES=20000
DATA_ARCHIVE_MAX_ENTRY_BYTES=1073741824
DATA_ARCHIVE_MAX_EXPANDED_BYTES=4294967296
