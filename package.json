{
  "name": "sora-blog",
  "version": "0.1.0",
  "private": true,
  "description": "A self-hosted full-stack blog inspired by halo-theme-sora.",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@10.26.2",
  "engines": {
    "node": ">=22.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  },
  "scripts": {
    "dev": "node scripts/migrate.mjs && next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typegen": "next typegen",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:runtime": "node scripts/migrate.mjs",
    "backup": "node scripts/backup.mjs",
    "restore": "node scripts/restore.mjs",
    "restore:pending": "node scripts/entrypoint.mjs --restore-only",
    "content:analyze": "node scripts/content-import.mjs analyze",
    "content:dry-run": "node scripts/content-import.mjs dry-run",
    "content:import": "node scripts/content-import.mjs import",
    "content:verify": "node scripts/content-import.mjs verify",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@bytemd/plugin-gfm": "1.22.0",
    "@bytemd/react": "1.22.0",
    "better-auth": "1.6.26",
    "better-sqlite3": "12.11.1",
    "bytemd": "1.22.0",
    "drizzle-orm": "0.45.2",
    "highlight.js": "11.11.1",
    "lucide-react": "1.29.0",
    "marked": "18.0.9",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sanitize-html": "2.17.6",
    "sharp": "0.35.3",
    "yauzl": "3.4.0",
    "yazl": "3.3.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/yauzl": "3.4.0",
    "@types/yazl": "3.3.1",
    "@vitest/coverage-v8": "4.1.10",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.0",
    "jsdom": "29.0.0",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
